# ---------------------------------------------------------------------------
# LuxeStays runtime configuration.
#
# NOTE: nothing here is a real secret. In this POC every value is injected at
# build time with --dart-define and the *client* only ever receives short-lived,
# narrowly scoped tokens minted by our own Backend-for-Frontend (BFF).
# Vendor secrets (SynXis client secret, Salesforce consumer secret, Leonardo
# API key) never ship inside the app binary - see docs/11-SECURITY.md.
# ---------------------------------------------------------------------------

FLAVOR=dev

# Our BFF / mock server
API_BASE_URL=http://localhost:8080

# Sabre SynXis (Aven Hospitality) - central reservations + booking engine
SYNXIS_BASE_URL=http://localhost:8080/synxis
SYNXIS_CHAIN_ID=12345
SYNXIS_BOOKING_ENGINE_URL=http://localhost:8080/be

# Salesforce - CRM, Loyalty Management, Service Cloud
SALESFORCE_BASE_URL=http://localhost:8080/salesforce
SALESFORCE_API_VERSION=v62.0
SALESFORCE_CLIENT_ID=luxestays_mobile_connected_app
SALESFORCE_LOYALTY_PROGRAM=LuxeStaysRewards

# Headless CMS (Contentful-shaped)
CMS_BASE_URL=http://localhost:8080/cms
CMS_SPACE_ID=luxestays
CMS_ENVIRONMENT=master

# Leonardo - hotel media
LEONARDO_BASE_URL=http://localhost:8080/leonardo
LEONARDO_AI_BASE_URL=http://localhost:8080/leonardo-ai

# Payment service provider hosted page (rendered inside a WebView)
PSP_HOSTED_PAGE_URL=http://localhost:8080/pay
